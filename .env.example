# Copy this file to .env and fill in your values.
# Never commit .env or any file containing real secrets.

# ----- Required -----

# Base URL of your wger instance (no trailing slash)
WGER_BASE_URL=https://wger.example.com

# ----- Token (choose one method) -----

# Option 1 (recommended for Docker): mount a file as a secret.
# In docker-compose.yml:
#   volumes:
#     - ./secrets/wger_api_token.txt:/run/secrets/wger_api_token:ro
# The app will automatically read /run/secrets/wger_api_token.

# Option 2: point to any file containing the token.
# WGER_API_TOKEN_FILE=/path/to/wger_token.txt

# Option 3: set the token directly as an env var (least preferred).
# WGER_API_TOKEN=your_token_here

# ----- Optional -----

# Display name for your hero character
HERO_NAME=Hero

# Environment label (development | production)
APP_ENV=production

# Override the database path (default: /data/wger_hero.db inside container)
# DATABASE_URL=sqlite:////data/wger_hero.db

# Set to false to skip /api/v2/log/ and exercise catalog fetching.
# Use this if your wger version does not have the log endpoint (returns 404).
# Default: true
# WGER_FETCH_EXERCISE_LOGS=false

# Only sync sessions on or after this date (ISO format: YYYY-MM-DD).
# Leave empty to sync all history. Useful to skip old sessions on first run.
# SYNC_FROM_DATE=2024-01-01

# --- Einbenutzer-Zugriffsschutz ------------------------------------------
# AUTH_ENABLED=false schaltet zusätzlich die CSRF-Prüfung ab und ist nur für
# lokale Tests gedacht. In Produktion immer true.
AUTH_ENABLED=true

# Argon2-Hash des einen Passworts, schreibgeschützt eingebunden.
# NIEMALS das Klartextpasswort und niemals den Hash selbst hier eintragen.
# Erzeugen (Passwort interaktiv, nicht in der Shell-History):
#   umask 077
#   python - <<'PY' > /srv/secrets/hero_password_hash
#   from argon2 import PasswordHasher
#   from getpass import getpass
#   print(PasswordHasher().hash(getpass("Passwort: ")), end="")
#   PY
#   chmod 400 /srv/secrets/hero_password_hash
AUTH_PASSWORD_HASH_FILE=/run/secrets/hero_password_hash

# Zufälliger Schlüssel zum Signieren des Sitzungs-Cookies.
# Erzeugen:  umask 077 && openssl rand -hex 32 > /srv/secrets/hero_session_secret
SESSION_SECRET_FILE=/run/secrets/hero_session_secret

# Sitzungsdauer in Sekunden (Vorgabe 7 Tage)
SESSION_MAX_AGE_SECONDS=604800

# Secure-Flag am Cookie. Hinter Caddy mit HTTPS immer true.
COOKIE_SECURE=true

# Zeitzone für Kalenderwochen, Streaks und Tagesansicht
APP_TIMEZONE=Europe/Berlin

# Begrenzung fehlgeschlagener Anmeldeversuche (in-process, kein Zusatzdienst)
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
